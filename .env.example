# Локальный запуск Go на Windows; Docker Compose использует адрес postgres:5432.
HTTP_ADDR=:8082
DATABASE_URL=postgres://queue:queue_local@localhost:5434/electronic_queue?sslmode=disable
DOCS_DIR=.
DB_MAX_CONNS=10
REQUEST_TIMEOUT=5s
SHUTDOWN_TIMEOUT=15s
DB_STATEMENT_TIMEOUT=3s
DB_LOCK_TIMEOUT=2s
# Сервис Compose test сам задаёт TEST_DATABASE_URL для отдельной test-db.
# Порт test-db не публикуется на Windows; запускать интеграционные тесты в Compose.
